  ORDENES_COMPRA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#2F4B7C"><FONT COLOR="white" POINT-SIZE="13"><B>ORDENES_COMPRA</B></FONT></TD></TR><TR><TD ALIGN="CENTER" BGCOLOR="#EAE0F5"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EAE0F5" PORT="ID_Orden_Compra"><B>ID_Orden_Compra</B></TD><TD ALIGN="LEFT" BGCOLOR="#EAE0F5"><FONT POINT-SIZE="9" COLOR="#444444">NUMBER</FONT></TD></TR><TR><TD ALIGN="CENTER" BGCOLOR="#EAE0F5"><FONT POINT-SIZE="9">&nbsp;</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EAE0F5" PORT="Numero_Orden">Numero_Orden</TD><TD ALIGN="LEFT" BGCOLOR="#EAE0F5"><FONT POINT-SIZE="9" COLOR="#444444">VARCHAR2(20)</FONT></TD></TR><TR><TD ALIGN="CENTER" BGCOLOR="#EAE0F5"><FONT POINT-SIZE="9">&nbsp;</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EAE0F5" PORT="Fecha_Orden">Fecha_Orden</TD><TD ALIGN="LEFT" BGCOLOR="#EAE0F5"><FONT POINT-SIZE="9" COLOR="#444444">DATE</FONT></TD></TR><TR><TD ALIGN="CENTER" BGCOLOR="#EAE0F5"><FONT POINT-SIZE="9">&nbsp;</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EAE0F5" PORT="Total_Compra">Total_Compra</TD><TD ALIGN="LEFT" BGCOLOR="#EAE0F5"><FONT POINT-SIZE="9" COLOR="#444444">NUMBER(12,2)</FONT></TD></TR><TR><TD ALIGN="CENTER" BGCOLOR="#EAE0F5"><FONT POINT-SIZE="9">&nbsp;</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EAE0F5" PORT="Estado_Orden">Estado_Orden</TD><TD ALIGN="LEFT" BGCOLOR="#EAE0F5"><FONT POINT-SIZE="9" COLOR="#444444">VARCHAR2(20)</FONT></TD></TR><TR><TD ALIGN="CENTER" BGCOLOR="#EAE0F5"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EAE0F5" PORT="ID_Proveedor">ID_Proveedor</TD><TD ALIGN="LEFT" BGCOLOR="#EAE0F5"><FONT POINT-SIZE="9" COLOR="#444444">NUMBER</FONT></TD></TR><TR><TD ALIGN="CENTER" BGCOLOR="#EAE0F5"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EAE0F5" PORT="ID_Sucursal">ID_Sucursal</TD><TD ALIGN="LEFT" BGCOLOR="#EAE0F5"><FONT POINT-SIZE="9" COLOR="#444444">NUMBER</FONT></TD></TR></TABLE>>];
  ORDENES_COMPRA_DETALLE [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#2F4B7C"><FONT COLOR="white" POINT-SIZE="13"><B>ORDENES_COMPRA_DETALLE</B></FONT></TD></TR><TR><TD ALIGN="CENTER" BGCOLOR="#EAE0F5"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EAE0F5" PORT="ID_Orden_Detalle"><B>ID_Orden_Detalle</B></TD><TD ALIGN="LEFT" BGCOLOR="#EAE0F5"><FONT POINT-SIZE="9" COLOR="#444444">NUMBER</FONT></TD></TR><TR><TD ALIGN="CENTER" BGCOLOR="#EAE0F5"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EAE0F5" PORT="ID_Orden_Compra">ID_Orden_Compra</TD><TD ALIGN="LEFT" BGCOLOR="#EAE0F5"><FONT POINT-SIZE="9" COLOR="#444444">NUMBER</FONT></TD></TR><TR><TD ALIGN="CENTER" BGCOLOR="#EAE0F5"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EAE0F5" PORT="ID_Producto">ID_Producto</TD><TD ALIGN="LEFT" BGCOLOR="#EAE0F5"><FONT POINT-SIZE="9" COLOR="#444444">NUMBER</FONT></TD></TR><TR><TD ALIGN="CENTER" BGCOLOR="#EAE0F5"><FONT POINT-SIZE="9">&nbsp;</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EAE0F5" PORT="Cantidad">Cantidad</TD><TD ALIGN="LEFT" BGCOLOR="#EAE0F5"><FONT POINT-SIZE="9" COLOR="#444444">NUMBER(6)</FONT></TD></TR><TR><TD ALIGN="CENTER" BGCOLOR="#EAE0F5"><FONT POINT-SIZE="9">&nbsp;</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EAE0F5" PORT="Precio_Compra_Unitario">Precio_Compra_Unitario</TD><TD ALIGN="LEFT" BGCOLOR="#EAE0F5"><FONT POINT-SIZE="9" COLOR="#444444">NUMBER(10,2)</FONT></TD></TR><TR><TD ALIGN="CENTER" BGCOLOR="#EAE0F5"><FONT POINT-SIZE="9">&nbsp;</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EAE0F5" PORT="Subtotal">Subtotal</TD><TD ALIGN="LEFT" BGCOLOR="#EAE0F5"><FONT POINT-SIZE="9" COLOR="#444444">NUMBER(12,2) (calc.)</FONT></TD></TR></TABLE>>];
  MOVIMIENTOS_INVENTARIO [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#2F4B7C"><FONT COLOR="white" POINT-SIZE="13"><B>MOVIMIENTOS_INVENTARIO</B></FONT></TD></TR><TR><TD ALIGN="CENTER" BGCOLOR="#E6E6E6"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#E6E6E6" PORT="ID_Movimiento"><B>ID_Movimiento</B></TD><TD ALIGN="LEFT" BGCOLOR="#E6E6E6"><FONT POINT-SIZE="9" COLOR="#444444">NUMBER</FONT></TD></TR><TR><TD ALIGN="CENTER" BGCOLOR="#E6E6E6"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#E6E6E6" PORT="ID_Producto">ID_Producto</TD><TD ALIGN="LEFT" BGCOLOR="#E6E6E6"><FONT POINT-SIZE="9" COLOR="#444444">NUMBER</FONT></TD></TR><TR><TD ALIGN="CENTER" BGCOLOR="#E6E6E6"><FONT POINT-SIZE="9">&nbsp;</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#E6E6E6" PORT="Fecha_Movimiento">Fecha_Movimiento</TD><TD ALIGN="LEFT" BGCOLOR="#E6E6E6"><FONT POINT-SIZE="9" COLOR="#444444">DATE</FONT></TD></TR><TR><TD ALIGN="CENTER" BGCOLOR="#E6E6E6"><FONT POINT-SIZE="9">&nbsp;</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#E6E6E6" PORT="Tipo_Movimiento">Tipo_Movimiento</TD><TD ALIGN="LEFT" BGCOLOR="#E6E6E6"><FONT POINT-SIZE="9" COLOR="#444444">VARCHAR2(10)</FONT></TD></TR><TR><TD ALIGN="CENTER" BGCOLOR="#E6E6E6"><FONT POINT-SIZE="9">&nbsp;</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#E6E6E6" PORT="Cantidad">Cantidad</TD><TD ALIGN="LEFT" BGCOLOR="#E6E6E6"><FONT POINT-SIZE="9" COLOR="#444444">NUMBER(8)</FONT></TD></TR><TR><TD ALIGN="CENTER" BGCOLOR="#E6E6E6"><FONT POINT-SIZE="9">&nbsp;</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#E6E6E6" PORT="Saldo_Resultante">Saldo_Resultante</TD><TD ALIGN="LEFT" BGCOLOR="#E6E6E6"><FONT POINT-SIZE="9" COLOR="#444444">NUMBER(8)</FONT></TD></TR><TR><TD ALIGN="CENTER" BGCOLOR="#E6E6E6"><FONT POINT-SIZE="9">&nbsp;</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#E6E6E6" PORT="Motivo">Motivo</TD><TD ALIGN="LEFT" BGCOLOR="#E6E6E6"><FONT POINT-SIZE="9" COLOR="#444444">VARCHAR2(100)</FONT></TD></TR><TR><TD ALIGN="CENTER" BGCOLOR="#E6E6E6"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#E6E6E6" PORT="ID_Factura">ID_Factura</TD><TD ALIGN="LEFT" BGCOLOR="#E6E6E6"><FONT POINT-SIZE="9" COLOR="#444444">NUMBER</FONT></TD></TR><TR><TD ALIGN="CENTER" BGCOLOR="#E6E6E6"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#E6E6E6" PORT="ID_Orden_Compra">ID_Orden_Compra</TD><TD ALIGN="LEFT" BGCOLOR="#E6E6E6"><FONT POINT-SIZE="9" COLOR="#444444">NUMBER</FONT></TD></TR></TABLE>>];
  CATEGORIAS -> PRODUCTOS [dir=both, arrowtail=teetee, arrowhead=crow, tooltip="ID_Categoria"];
  PROVEEDORES -> PRODUCTOS [dir=both, arrowtail=teetee, arrowhead=crow, tooltip="ID_Proveedor"];
  SUCURSALES -> EMPLEADOS [dir=both, arrowtail=teetee, arrowhead=crow, tooltip="ID_Sucursal"];
  EMPLEADOS -> USUARIOS [dir=both, arrowtail=teetee, arrowhead=teetee, tooltip="ID_Empleado"];
  ROLES -> USUARIOS [dir=both, arrowtail=teetee, arrowhead=crow, tooltip="ID_Rol"];
  CLIENTES -> FACTURAS_ENCABEZADO [dir=both, arrowtail=teetee, arrowhead=crow, tooltip="ID_Cliente"];
  EMPLEADOS -> FACTURAS_ENCABEZADO [dir=both, arrowtail=teetee, arrowhead=crow, tooltip="ID_Empleado"];
  FACTURAS_ENCABEZADO -> FACTURAS_DETALLE [dir=both, arrowtail=teetee, arrowhead=crow, tooltip="ID_Factura"];
  PRODUCTOS -> FACTURAS_DETALLE [dir=both, arrowtail=teetee, arrowhead=crow, tooltip="ID_Producto"];
  FACTURAS_ENCABEZADO -> PAGOS_FACTURA [dir=both, arrowtail=teetee, arrowhead=crowodot, tooltip="ID_Factura"];
  METODOS_PAGO -> PAGOS_FACTURA [dir=both, arrowtail=teetee, arrowhead=crow, tooltip="ID_Metodo_Pago"];
  PROVEEDORES -> ORDENES_COMPRA [dir=both, arrowtail=teetee, arrowhead=crow, tooltip="ID_Proveedor"];
  SUCURSALES -> ORDENES_COMPRA [dir=both, arrowtail=teetee, arrowhead=crow, tooltip="ID_Sucursal"];
  ORDENES_COMPRA -> ORDENES_COMPRA_DETALLE [dir=both, arrowtail=teetee, arrowhead=crow, tooltip="ID_Orden_Compra"];
  PRODUCTOS -> ORDENES_COMPRA_DETALLE [dir=both, arrowtail=teetee, arrowhead=crow, tooltip="ID_Producto"];
  PRODUCTOS -> MOVIMIENTOS_INVENTARIO [dir=both, arrowtail=teetee, arrowhead=crow, tooltip="ID_Producto"];
  FACTURAS_ENCABEZADO -> MOVIMIENTOS_INVENTARIO [dir=both, arrowtail=teetee, arrowhead=crowodot, tooltip="ID_Factura"];
  ORDENES_COMPRA -> MOVIMIENTOS_INVENTARIO [dir=both, arrowtail=teetee, arrowhead=crowodot, tooltip="ID_Orden_Compra"];
  leyenda [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="2" BGCOLOR="#2F4B7C"><FONT COLOR="white"><B>Leyenda</B></FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2">PK = llave primaria (negrita) &nbsp;|&nbsp; FK = llave foránea &nbsp;|&nbsp; (calc.) = columna virtual</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2">Barras dobles = lado "uno" (1) &nbsp;|&nbsp; Pata de gallo = lado "muchos" (N) &nbsp;|&nbsp; Círculo = participación opcional</TD></TR><TR><TD BGCOLOR="#DCEBFA" WIDTH="22"> </TD><TD ALIGN="LEFT">Catálogos</TD></TR><TR><TD BGCOLOR="#E4F3E1" WIDTH="22"> </TD><TD ALIGN="LEFT">Personal y seguridad</TD></TR><TR><TD BGCOLOR="#FFF1CC" WIDTH="22"> </TD><TD ALIGN="LEFT">Inventario</TD></TR><TR><TD BGCOLOR="#FBE0E0" WIDTH="22"> </TD><TD ALIGN="LEFT">Ventas</TD></TR><TR><TD BGCOLOR="#EAE0F5" WIDTH="22"> </TD><TD ALIGN="LEFT">Compras</TD></TR><TR><TD BGCOLOR="#E6E6E6" WIDTH="22"> </TD><TD ALIGN="LEFT">Kardex</TD></TR></TABLE>>];
}