digraph G {
  label=<<FONT POINT-SIZE="20"><B>Modelo Entidad-Relación — Sistema de Inventario y Facturación</B></FONT>>; labelloc=t;
  graph [rankdir=LR, nodesep=0.5, ranksep=1.3, pad=0.4, fontname="Helvetica", dpi=130];
  node [shape=plain, fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=10, color="#555555"];
  CATEGORIAS [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#2F4B7C"><FONT COLOR="white" POINT-SIZE="13"><B>CATEGORIAS</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#DCEBFA" PORT="ID_Categoria" COLSPAN="3"><U><B>ID_Categoria</B></U></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#DCEBFA" PORT="Nombre_Categoria" COLSPAN="3">Nombre_Categoria</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#DCEBFA" PORT="Descripcion" COLSPAN="3">Descripcion</TD></TR></TABLE>>];
  PROVEEDORES [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#2F4B7C"><FONT COLOR="white" POINT-SIZE="13"><B>PROVEEDORES</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#DCEBFA" PORT="ID_Proveedor" COLSPAN="3"><U><B>ID_Proveedor</B></U></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#DCEBFA" PORT="Nombre_Empresa" COLSPAN="3">Nombre_Empresa</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#DCEBFA" PORT="NIT" COLSPAN="3">NIT</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#DCEBFA" PORT="Telefono" COLSPAN="3">Telefono</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#DCEBFA" PORT="Correo" COLSPAN="3">Correo</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#DCEBFA" PORT="Contacto_Principal" COLSPAN="3">Contacto_Principal</TD></TR></TABLE>>];
  CLIENTES [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#2F4B7C"><FONT COLOR="white" POINT-SIZE="13"><B>CLIENTES</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#DCEBFA" PORT="ID_Cliente" COLSPAN="3"><U><B>ID_Cliente</B></U></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#DCEBFA" PORT="NIT" COLSPAN="3">NIT</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#DCEBFA" PORT="Nombre_Completo" COLSPAN="3">Nombre_Completo</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#DCEBFA" PORT="Direccion" COLSPAN="3">Direccion</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#DCEBFA" PORT="Telefono" COLSPAN="3">Telefono</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#DCEBFA" PORT="Correo" COLSPAN="3">Correo</TD></TR></TABLE>>];
  SUCURSALES [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#2F4B7C"><FONT COLOR="white" POINT-SIZE="13"><B>SUCURSALES</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#DCEBFA" PORT="ID_Sucursal" COLSPAN="3"><U><B>ID_Sucursal</B></U></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#DCEBFA" PORT="Nombre_Sucursal" COLSPAN="3">Nombre_Sucursal</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#DCEBFA" PORT="Direccion" COLSPAN="3">Direccion</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#DCEBFA" PORT="Telefono" COLSPAN="3">Telefono</TD></TR></TABLE>>];
  ROLES [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#2F4B7C"><FONT COLOR="white" POINT-SIZE="13"><B>ROLES</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E4F3E1" PORT="ID_Rol" COLSPAN="3"><U><B>ID_Rol</B></U></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E4F3E1" PORT="Nombre_Rol" COLSPAN="3">Nombre_Rol</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E4F3E1" PORT="Descripcion" COLSPAN="3">Descripcion</TD></TR></TABLE>>];
  METODOS_PAGO [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#2F4B7C"><FONT COLOR="white" POINT-SIZE="13"><B>METODOS_PAGO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#DCEBFA" PORT="ID_Metodo_Pago" COLSPAN="3"><U><B>ID_Metodo_Pago</B></U></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#DCEBFA" PORT="Nombre_Metodo" COLSPAN="3">Nombre_Metodo</TD></TR></TABLE>>];
  EMPLEADOS [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#2F4B7C"><FONT COLOR="white" POINT-SIZE="13"><B>EMPLEADOS</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E4F3E1" PORT="ID_Empleado" COLSPAN="3"><U><B>ID_Empleado</B></U></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E4F3E1" PORT="DPI_Cedula" COLSPAN="3">DPI_Cedula</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E4F3E1" PORT="Nombre_Completo" COLSPAN="3">Nombre_Completo</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E4F3E1" PORT="Cargo" COLSPAN="3">Cargo</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E4F3E1" PORT="Salario" COLSPAN="3">Salario</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E4F3E1" PORT="Fecha_Contratacion" COLSPAN="3">Fecha_Contratacion</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E4F3E1" PORT="ID_Sucursal" COLSPAN="3"><I>ID_Sucursal</I></TD></TR></TABLE>>];
  USUARIOS [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#2F4B7C"><FONT COLOR="white" POINT-SIZE="13"><B>USUARIOS</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E4F3E1" PORT="ID_Usuario" COLSPAN="3"><U><B>ID_Usuario</B></U></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E4F3E1" PORT="Username" COLSPAN="3">Username</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E4F3E1" PORT="Password_Hash" COLSPAN="3">Password_Hash</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E4F3E1" PORT="Estado" COLSPAN="3">Estado</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E4F3E1" PORT="ID_Empleado" COLSPAN="3"><I>ID_Empleado</I></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E4F3E1" PORT="ID_Rol" COLSPAN="3"><I>ID_Rol</I></TD></TR></TABLE>>];
  PRODUCTOS [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#2F4B7C"><FONT COLOR="white" POINT-SIZE="13"><B>PRODUCTOS</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF1CC" PORT="ID_Producto" COLSPAN="3"><U><B>ID_Producto</B></U></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF1CC" PORT="Codigo_Barras" COLSPAN="3">Codigo_Barras</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF1CC" PORT="Nombre_Producto" COLSPAN="3">Nombre_Producto</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF1CC" PORT="Precio_Compra" COLSPAN="3">Precio_Compra</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF1CC" PORT="Precio_Venta" COLSPAN="3">Precio_Venta</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF1CC" PORT="Stock_Actual" COLSPAN="3">Stock_Actual</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF1CC" PORT="Stock_Minimo" COLSPAN="3">Stock_Minimo</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF1CC" PORT="ID_Categoria" COLSPAN="3"><I>ID_Categoria</I></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF1CC" PORT="ID_Proveedor" COLSPAN="3"><I>ID_Proveedor</I></TD></TR></TABLE>>];
  FACTURAS_ENCABEZADO [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#2F4B7C"><FONT COLOR="white" POINT-SIZE="13"><B>FACTURAS_ENCABEZADO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FBE0E0" PORT="ID_Factura" COLSPAN="3"><U><B>ID_Factura</B></U></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FBE0E0" PORT="Numero_Factura" COLSPAN="3">Numero_Factura</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FBE0E0" PORT="Fecha_Emision" COLSPAN="3">Fecha_Emision</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FBE0E0" PORT="Subtotal_Factura" COLSPAN="3">Subtotal_Factura</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FBE0E0" PORT="Impuesto_IVA" COLSPAN="3">Impuesto_IVA</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FBE0E0" PORT="Total_Factura" COLSPAN="3">Total_Factura</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FBE0E0" PORT="Estado" COLSPAN="3">Estado</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FBE0E0" PORT="ID_Cliente" COLSPAN="3"><I>ID_Cliente</I></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FBE0E0" PORT="ID_Empleado" COLSPAN="3"><I>ID_Empleado</I></TD></TR></TABLE>>];
  FACTURAS_DETALLE [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#2F4B7C"><FONT COLOR="white" POINT-SIZE="13"><B>FACTURAS_DETALLE</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FBE0E0" PORT="ID_Detalle" COLSPAN="3"><U><B>ID_Detalle</B></U></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FBE0E0" PORT="ID_Factura" COLSPAN="3"><I>ID_Factura</I></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FBE0E0" PORT="ID_Producto" COLSPAN="3"><I>ID_Producto</I></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FBE0E0" PORT="Cantidad" COLSPAN="3">Cantidad</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FBE0E0" PORT="Precio_Unitario" COLSPAN="3">Precio_Unitario</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FBE0E0" PORT="Subtotal" COLSPAN="3">Subtotal</TD></TR></TABLE>>];
  PAGOS_FACTURA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#2F4B7C"><FONT COLOR="white" POINT-SIZE="13"><B>PAGOS_FACTURA</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FBE0E0" PORT="ID_Pago" COLSPAN="3"><U><B>ID_Pago</B></U></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FBE0E0" PORT="Monto_Pagado" COLSPAN="3">Monto_Pagado</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FBE0E0" PORT="Fecha_Pago" COLSPAN="3">Fecha_Pago</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FBE0E0" PORT="Numero_Transaccion" COLSPAN="3">Numero_Transaccion</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FBE0E0" PORT="ID_Factura" COLSPAN="3"><I>ID_Factura</I></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FBE0E0" PORT="ID_Metodo_Pago" COLSPAN="3"><I>ID_Metodo_Pago</I></TD></TR></TABLE>>];
  ORDENES_COMPRA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#2F4B7C"><FONT COLOR="white" POINT-SIZE="13"><B>ORDENES_COMPRA</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAE0F5" PORT="ID_Orden_Compra" COLSPAN="3"><U><B>ID_Orden_Compra</B></U></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAE0F5" PORT="Numero_Orden" COLSPAN="3">Numero_Orden</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAE0F5" PORT="Fecha_Orden" COLSPAN="3">Fecha_Orden</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAE0F5" PORT="Total_Compra" COLSPAN="3">Total_Compra</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAE0F5" PORT="Estado_Orden" COLSPAN="3">Estado_Orden</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAE0F5" PORT="ID_Proveedor" COLSPAN="3"><I>ID_Proveedor</I></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAE0F5" PORT="ID_Sucursal" COLSPAN="3"><I>ID_Sucursal</I></TD></TR></TABLE>>];
  ORDENES_COMPRA_DETALLE [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#2F4B7C"><FONT COLOR="white" POINT-SIZE="13"><B>ORDENES_COMPRA_DETALLE</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAE0F5" PORT="ID_Orden_Detalle" COLSPAN="3"><U><B>ID_Orden_Detalle</B></U></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAE0F5" PORT="ID_Orden_Compra" COLSPAN="3"><I>ID_Orden_Compra</I></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAE0F5" PORT="ID_Producto" COLSPAN="3"><I>ID_Producto</I></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAE0F5" PORT="Cantidad" COLSPAN="3">Cantidad</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAE0F5" PORT="Precio_Compra_Unitario" COLSPAN="3">Precio_Compra_Unitario</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAE0F5" PORT="Subtotal" COLSPAN="3">Subtotal</TD></TR></TABLE>>];
  MOVIMIENTOS_INVENTARIO [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#2F4B7C"><FONT COLOR="white" POINT-SIZE="13"><B>MOVIMIENTOS_INVENTARIO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E6E6E6" PORT="ID_Movimiento" COLSPAN="3"><U><B>ID_Movimiento</B></U></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E6E6E6" PORT="ID_Producto" COLSPAN="3"><I>ID_Producto</I></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E6E6E6" PORT="Fecha_Movimiento" COLSPAN="3">Fecha_Movimiento</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E6E6E6" PORT="Tipo_Movimiento" COLSPAN="3">Tipo_Movimiento</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E6E6E6" PORT="Cantidad" COLSPAN="3">Cantidad</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E6E6E6" PORT="Saldo_Resultante" COLSPAN="3">Saldo_Resultante</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E6E6E6" PORT="Motivo" COLSPAN="3">Motivo</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E6E6E6" PORT="ID_Factura" COLSPAN="3"><I>ID_Factura</I></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E6E6E6" PORT="ID_Orden_Compra" COLSPAN="3"><I>ID_Orden_Compra</I></TD></TR></TABLE>>];
  CATEGORIAS -> PRODUCTOS [dir=both, arrowtail=teetee, arrowhead=crow, label="agrupa", taillabel="1", headlabel="N", labeldistance=2.2];
  PROVEEDORES -> PRODUCTOS [dir=both, arrowtail=teetee, arrowhead=crow, label="suministra", taillabel="1", headlabel="N", labeldistance=2.2];
  SUCURSALES -> EMPLEADOS [dir=both, arrowtail=teetee, arrowhead=crow, label="emplea", taillabel="1", headlabel="N", labeldistance=2.2];
  EMPLEADOS -> USUARIOS [dir=both, arrowtail=teetee, arrowhead=teetee, label="posee cuenta", taillabel="1", headlabel="1", labeldistance=2.2];
  ROLES -> USUARIOS [dir=both, arrowtail=teetee, arrowhead=crow, label="asigna", taillabel="1", headlabel="N", labeldistance=2.2];
  CLIENTES -> FACTURAS_ENCABEZADO [dir=both, arrowtail=teetee, arrowhead=crow, label="compra", taillabel="1", headlabel="N", labeldistance=2.2];
  EMPLEADOS -> FACTURAS_ENCABEZADO [dir=both, arrowtail=teetee, arrowhead=crow, label="vende", taillabel="1", headlabel="N", labeldistance=2.2];
  FACTURAS_ENCABEZADO -> FACTURAS_DETALLE [dir=both, arrowtail=teetee, arrowhead=crow, label="contiene", taillabel="1", headlabel="N", labeldistance=2.2];
  PRODUCTOS -> FACTURAS_DETALLE [dir=both, arrowtail=teetee, arrowhead=crow, label="se vende en", taillabel="1", headlabel="N", labeldistance=2.2];
  FACTURAS_ENCABEZADO -> PAGOS_FACTURA [dir=both, arrowtail=teetee, arrowhead=crowodot, label="se paga con", taillabel="1", headlabel="N", labeldistance=2.2];
  METODOS_PAGO -> PAGOS_FACTURA [dir=both, arrowtail=teetee, arrowhead=crow, label="clasifica", taillabel="1", headlabel="N", labeldistance=2.2];
  PROVEEDORES -> ORDENES_COMPRA [dir=both, arrowtail=teetee, arrowhead=crow, label="recibe", taillabel="1", headlabel="N", labeldistance=2.2];
  SUCURSALES -> ORDENES_COMPRA [dir=both, arrowtail=teetee, arrowhead=crow, label="solicita", taillabel="1", headlabel="N", labeldistance=2.2];
  ORDENES_COMPRA -> ORDENES_COMPRA_DETALLE [dir=both, arrowtail=teetee, arrowhead=crow, label="contiene", taillabel="1", headlabel="N", labeldistance=2.2];
  PRODUCTOS -> ORDENES_COMPRA_DETALLE [dir=both, arrowtail=teetee, arrowhead=crow, label="se compra en", taillabel="1", headlabel="N", labeldistance=2.2];
  PRODUCTOS -> MOVIMIENTOS_INVENTARIO [dir=both, arrowtail=teetee, arrowhead=crow, label="registra", taillabel="1", headlabel="N", labeldistance=2.2];
  FACTURAS_ENCABEZADO -> MOVIMIENTOS_INVENTARIO [dir=both, arrowtail=teetee, arrowhead=crowodot, label="origina salida", taillabel="1", headlabel="N", labeldistance=2.2];
  ORDENES_COMPRA -> MOVIMIENTOS_INVENTARIO [dir=both, arrowtail=teetee, arrowhead=crowodot, label="origina entrada", taillabel="1", headlabel="N", labeldistance=2.2];
  leyenda [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="2" BGCOLOR="#2F4B7C"><FONT COLOR="white"><B>Leyenda</B></FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><U><B>Subrayado</B></U> = llave primaria (PK) &nbsp;|&nbsp; <I>cursiva</I> = llave foránea (FK)</TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2">Barras dobles = lado "uno" (1) &nbsp;|&nbsp; Pata de gallo = lado "muchos" (N) &nbsp;|&nbsp; Círculo = participación opcional</TD></TR><TR><TD BGCOLOR="#DCEBFA" WIDTH="22"> </TD><TD ALIGN="LEFT">Catálogos</TD></TR><TR><TD BGCOLOR="#E4F3E1" WIDTH="22"> </TD><TD ALIGN="LEFT">Personal y seguridad</TD></TR><TR><TD BGCOLOR="#FFF1CC" WIDTH="22"> </TD><TD ALIGN="LEFT">Inventario</TD></TR><TR><TD BGCOLOR="#FBE0E0" WIDTH="22"> </TD><TD ALIGN="LEFT">Ventas</TD></TR><TR><TD BGCOLOR="#EAE0F5" WIDTH="22"> </TD><TD ALIGN="LEFT">Compras</TD></TR><TR><TD BGCOLOR="#E6E6E6" WIDTH="22"> </TD><TD ALIGN="LEFT">Kardex</TD></TR></TABLE>>];
}